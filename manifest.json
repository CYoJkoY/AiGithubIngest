{
  "manifest_version": 3,
  "name": "AI GitHub Ingest Engine",
  "version": "0.3.1",
  "description": "在 AI 站点粘贴 GitHub 链接时，纯本地解析并注入结构化代码上下文，无需依赖第三方在线服务。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://codeload.github.com/*",
    "https://github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "toast.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
